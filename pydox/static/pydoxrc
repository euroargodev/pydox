# =============================================
#    PYDOX Default Configuration Parameters
#
# - Environment variables can be used with ${ENV}, they will be 'filled' when pydox load the configuration.
# - Although '-' can be used, we prefer the more reliable '_' in strings (eg: 'in_air' rather than 'in-air').
# - Nulls in YAML can be expressed with null or ~. This will be loaded as None in Python.
# - Paths use posix convention (i.e. always use '/', even on Windows OS).
#
version: '0.1' # Pydox configuration file format version (must be in any configuration file, and an explicit string)

# ============================================= Operator Designation
operator:
  name: # e.g. = ${USER} ('factory' value)
  email:
  orcid:
  affiliation:

# ============================================= Root path for output
# Root path to save all pydox output: calibration/adjustment data, figures, reports, logs
output:
  root: # e.g. : ${HOME}/ARGO/DMQC/OXYGEN/PYDOX. If this parameter is None at runtime, Pydox will automatically set it to: ${CWD}/pydox

# ============================================= Argo Float data
argo:
  src: https://data-argo.ifremer.fr  # Anything :class:`argopy.ArgoFloat` argument 'host' can support
#  src: ftp
  use: 3  # 1: raw, 2: adjusted, 3: adjusted if available else raw
  qcflags: # Which QC to use data for
    pres: [1, 2, 8]
    temp: [1, 2, 8]
    psal: [1, 2, 8]
    doxy: [1, 2, 8, 3]
  in_water_salinity:
    # Min and max pressure to extract the salinity for in-water data (because for in-water data, the pump is off).
    # So, we take the salinity from the profile (with the pump on).
    min_pressure: 0.  # dbar
    max_pressure: 10. # dbar
  codes:
    in_air: [699, 711, 799] # Argo Code associated to InAir Data in the Rtraj Argo file
    in_water: [690, 710] # Argo Code associated to InWater Data in the Rtraj Argo file
  optode_height : -0.2 # [m] Default value to use if the CONFIG_OptodeVerticalPressureOffset_dbar parameter is not available

# ============================================= Calibration Methods Parameters
calibration_methods:
  default: in_air

  in_air:
    long_name: This would be a long name for the 'in air' methodology
    reference: http://dx.doi/...
    carryover: False
    dataset: ncep
    data:
      ncep:
        name: NCEP 2, real-time ?
        src: # e.g. : ${HOME}/ARGO_NEW/NEW_LOCODOX/NCEP_DATA/
      era5:
        name: ERA5, higher res ?
        src: null

  climatology:
     min_pressure: 0.  # dbar
     max_pressure: 25. # dbar
     dataset: woa
     data:
        woa:
          name: WOA18
          src: # e.g. : ${HOME}/ARGO_NEW/LOCODOX/DATA/LOCODOX_EXTERNAL_DATA/WOA/WOA2018_DECAV_monthly_5500_1deg.nc
        isas:
          name: ISAS19
          comment: To be implemented !
          src: null

  reference_profile:
     pressure_effect:
       enabled: True
       threshold: 1000.  # Pressure threshold for pressure effect estimation (dbar)
     dataset: lops
     data:
       lops:
         name: LOPS-ctd (2025)
         comment: | 
           LOPS-curated collection of oxygen reference profiles from ship-ctd.
           This version includes the last OVIDE 2024 data.
         txt: # e.g. : ${HOME}/ARGO_NEW/NEW_LOCODOX/locodox_python/BDD_TR/bdd_REF_ARGO.txt
         mat: # e.g. : ${HOME}/ARGO_NEW/NEW_LOCODOX/locodox_python/BDD_TR/bddo2ref_all_2025.mat

# ============================================= Calibration Shared Parameters
# These parameters are used by all methods
calibration_parameters:
  piecewise: # The logic must be clarified in here to end up with a consistent set of parameters for piecewise !
    auto_segment: False # Let pydox determine if more than one segment is needed or not, and how many are needed
    nb_segments: 1  # 1 means no piecewise fit, overwritten if auto_segment=True
    auto_break: True # Let pydox determine where to break segments
    breakpoints: null  # list of integers for cycle numbers to break, only used if auto_break=False
  initial_guess:
    gain: 1.
    drift: 0.
  fit_drift: False
  cycles: [first, last] # Cycle numbers to use to estimate coefficients, this is a range
  data:
    save:
      format: json
      prefix: calib_
      path: data
      # <output.root>/<WMO>/<calibration_parameters.data.save.path>/<calibration_parameters.data.save.prefix>{file_name}.<calibration_parameters.data.save.format>
  plots:
    save:
      format: png
      prefix: calib_
      path: docs/img
      # <output.root>/<WMO>/<calibration_parameters.plots.save.path>/{figure_name}.<calibration_parameters.plots.save.format>

# =============================================  CalibrationSet parameters
calibration_set:
  description:
    name: null
    long_name: null
    comment: null
  ordered: False
  accumulate_gain: False
  data:
    save:
      format: json
      prefix: calibset_
      path: data
      # <output.root>/<WMO>/<calibration_set.data.save.path>/<calibration_set.data.save.prefix>{file_name}.<calibration_set.data.save.format>
  plots:
    save:
      format: png
      prefix: calibset_
      path: docs/img
    # <output.root>/<WMO>/<calibration_set.plots.save.path>/<calibration_set.plots.save.prefix>{figure_name}.<calibration_set.plots.save.format>

# ============================================= Adjustment Parameters
adjustment:
  relative_error: 2.0  # Relative error for BD files (%)
  cycles: [first, last] # Cycle numbers to apply adjustment to
  convention: Argo-3.1 CF-1.6
  save:
    path: netcdf
    # <output.root>/<WMO>/<adjustment.save.path>/profiles/BD<WMO>_<CYC>.nc

# ============================================= Plotting
plots:
  dpi: 120 # The resolution of figures, in dots-per-inch
  level: 0 # Minimal plot category level (>=0: debug plots, >=10: input data plots, >=20: fit results or high-level APIs).
  # Set this to the lowest value 0 to ensure the generation of all possible plots.
  watermark:
    show: True # Display or not by default
    default: 'Pydox' # Text that will always be displayed on figures. Set 'show' attribute to False to disable, not an empty string here
    fontsize: 24
    color: MEDIUM # Use a string value from the 'reports.template' setting color scheme: DARKEST, DARK, MEDIUM_DARK, MEDIUM, LIGHT_MEDIUM, LIGHT, LIGHTEST
  configs_layout: ['hue', 'subplot', 'figure'] # Generate all these layout when plotting data from more than one configuration at a time.
  save:
    format: png
    path: docs/img
    # <output.root>/<WMO>/<plots.save.path>/{figure_name}.<plots.save.format>
  bathymetry:
    depths_contours:
      min: -7000.
      max: 500.
      step: 500.
  extend_lon_lat: 1  # Extend longitude/latitude for position plots
  mplstyle: # Use this setting to apply a custom MPL stylesheet file, e.g. : ${HOME}/PYDOX/CUSTOM_TEMPLATES/custom.mplstyle
    # Pydox stylesheet is used by default.
    # See also: https://matplotlib.org/stable/users/explain/customizing.html#defining-your-own-style

# ============================================= Reporting
reports:
  template: pydox # Name of the template to use by default. Must be defined as group under 'reports.templates'
  templates:
    pydox:
      name: Pydox
      colors: ['#0a2463', '#023978', '#0c9eb3', '#14b1b7', '#7bcacc', '#bae3e2', '#f8fbf8']
      # Must be 7 HEX colors, from dark to light
      # https://coolors.co/0a2463-023978-0c9eb3-14b1b7-7bcacc-bae3e2-f8fbf8
      html: default.html
#      latex:

  save:
    format: html
    prefix: null # loaded as None, no prefix
    path: docs
    # <output.root>/<WMO>/<reports.save.path>/<reports.save.prefix>{report_name}.<reports.save.format>

# ============================================= Bathymetry
bathymetry:
  default: gebco
  etopo:
    long_name: ETOPO v2
    src: # e.g. : ${HOME}/ARGO_NEW/LOCODOX/DATA/LOCODOX_EXTERNAL_DATA/TOPOGRAPHY/ETOPO2v2c_f4.nc
  gebco:
    long_name: GEBCO 2020, a continuous terrain model for oceans and land at 15 arc-second intervals
    src: https://coastwatch.pfeg.noaa.gov/erddap/griddap/GEBCO_2020.html

# ============================================= Units
# Pressure Coefficients (sensor-specific)
pressure_coefficients:
  aanderaa:
    pcoef2: 0.00022
    pcoef3: 0.0419
  rinko:
    pcoef2: 0.
    pcoef3: 0.04

# ============================================= Pydox user interface
pydox:
  logging_level: 'DEBUG' # Standard logging library value, https://docs.python.org/3/library/logging.html#logging-levels
  screen: # About printing feedbacks to user on screen (stdout)
    log: True # print or not ?
    min_context_level: 10 # Set the minimal APIs context level to print messages from,
                         # i.e. messages from APIs with a higher context level will be printed on screen.
                         # (>=0: low-level APIs, >=10: intermediate-level APIs, >=20: high-level APIs)
  verbose:
    cell_text: False # Should we force to use text output in notebook cells, even when HTML is available
    configs: False  # Should we print ALL parameters of a configuration set, or omit meta-data like src of the reference dataset


# ============================================= Misc
specification: 1.2.2 # YAML specification https://yaml.org/spec/1.2.2/

