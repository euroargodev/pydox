# DEFAULT PYDOX MATPLOTLIB STYLE (do not edit directly)

figure.facecolor: white
figure.titlesize: x-large     # size of the figure title (``Figure.suptitle()``)

axes.edgecolor: (0.00784313725490196, 0.2235294117647059, 0.47058823529411764, 1.0) # COLORS.DARK
axes.facecolor: white
axes.labelcolor:  (0.047058823529411764, 0.6196078431372549, 0.7019607843137254, 1.0) # COLORS.DARK
axes.grid: True
axes.axisbelow: line
# axes.prop_cycle: cycler('color', ['m', 'c', 'y', 'k'])
axes.prop_cycle: cycler('color', ['377eb8', 'ff7f00', '4daf4a', 'f781bf', 'a65628', '984ea3', '999999', 'e41a1c', 'dede00'])
axes.spines.left: True
axes.spines.bottom: True
axes.spines.right: True
axes.spines.top: True

grid.color: (0.047058823529411764, 0.6196078431372549, 0.7019607843137254, 1.0) # COLORS.DARK
grid.linestyle: :
grid.linewidth: 0.8
grid.alpha: 1.0

text.color: (0.0392156862745098, 0.1411764705882353, 0.38823529411764707, 1.0) # COLORS.DARKEST
#axes.titlecolor:    (0.0392156862745098, 0.1411764705882353, 0.38823529411764707, 1.0) # or inherit from text.color

patch.edgecolor: black
patch.force_edgecolor: False

image.cmap: viridis

xtick.color: (0.047058823529411764, 0.6196078431372549, 0.7019607843137254, 1.0) # COLORS.DARK
# xtick.labelcolor:  'r' #(0.00784313725490196, 0.2235294117647059, 0.47058823529411764, 1.0) # color of the tick labels or inherit from xtick.color
xtick.top: False
xtick.bottom: True

ytick.color: (0.047058823529411764, 0.6196078431372549, 0.7019607843137254, 1.0) # COLORS.DARK
# ytick.labelcolor: (0.00784313725490196, 0.2235294117647059, 0.47058823529411764, 1.0) # color of the tick labels or inherit from ytick.color
ytick.left: True
ytick.right: False

# "legend.facecolor":     inherit,  # inherit from axes.facecolor; or color spec
#legend.edgecolor: 0.8
legend.edgecolor: (0.00784313725490196, 0.2235294117647059, 0.47058823529411764, 1.0) # COLORS.DARK
